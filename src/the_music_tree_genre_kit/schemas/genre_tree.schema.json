{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BehindTheMusicTree/the-music-tree-genre-kit/src/the_music_tree_genre_kit/schemas/genre_tree.schema.json",
  "title": "Genre tree export",
  "type": "object",
  "properties": {
    "treeName": { "enum": ["canonical", "regional"] },
    "curationExportedOn": { "type": "string", "format": "date-time", "minLength": 1 },
    "tree": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "crossTreeSecondaryParents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "secondaryParents": { "$ref": "#/$defs/parentRefs" }
        },
        "required": ["id", "secondaryParents"],
        "additionalProperties": false
      }
    }
  },
  "required": ["treeName", "curationExportedOn", "tree"],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "side": { "type": "string", "enum": ["pop"] },
        "isUnacceptedRoot": { "type": "boolean", "const": true },
        "isUmbrella": { "type": "boolean", "const": true },
        "scene": { "type": "string", "enum": ["commercial", "underground"] },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "primaryParents": { "$ref": "#/$defs/parentRefs" },
        "secondaryParents": { "$ref": "#/$defs/parentRefs" },
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "summarySourceUrl": { "type": "string", "minLength": 1 },
        "image": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
            "pageUrl": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
            "author": { "type": ["string", "null"], "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "licenseUrl": { "type": ["string", "null"], "pattern": "^https?://", "maxLength": 2048 }
          },
          "required": ["url", "pageUrl", "author", "license", "licenseUrl"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "children"],
      "if": { "required": ["isUmbrella"] },
      "then": { "properties": { "children": { "minItems": 1 } } },
      "additionalProperties": false
    },
    "parentRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
